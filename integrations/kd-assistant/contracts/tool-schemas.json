{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "kd-api-v1",
  "description": "Tool-Angebot wird nach GET /v1/capabilities gefiltert. Member erhalten keine ai_-, usage_-, requests_- oder backend_-Tools.",
  "tools": [
    {"name":"capabilities_get","description":"Zeigt die aktuell erlaubten Kinodreieck-Funktionen.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/empty"}},
    {"name":"library_search","description":"Sucht nur im fuer das aktive Konto lesbaren Medienbestand.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/search"}},
    {"name":"library_get","description":"Liest einen eigenen oder freigegebenen Mediathekeintrag.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/id"}},
    {"name":"library_add","description":"Fuegt einen Medieneintrag revisionsgebunden hinzu.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/createMutation"}},
    {"name":"library_update","description":"Aendert erlaubte Felder eines Medieneintrags.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/updateMutation"}},
    {"name":"library_remove","description":"Entfernt einen eigenen Mediathekeintrag.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/removeMutation"}},
    {"name":"library_export_selection","description":"Projiziert geordnete IDs als Titeltext oder kinodreieck-paket v1; speichert keine Sammlung.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/selection"}},
    {"name":"mustwatch_list","description":"Listet die eigene Must-Watch-Liste.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"mustwatch_add","description":"Fuegt einen Must-Watch-Eintrag hinzu.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/createMutation"}},
    {"name":"mustwatch_update","description":"Aendert einen Must-Watch-Eintrag.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/updateMutation"}},
    {"name":"mustwatch_remove","description":"Entfernt einen Must-Watch-Eintrag.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/removeMutation"}},
    {"name":"blog_drafts_list","description":"Listet eigene private Blogentwuerfe.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"blog_draft_get","description":"Liest einen eigenen Blogentwurf.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/id"}},
    {"name":"blog_draft_create","description":"Erstellt einen privaten Blogentwurf.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/createMutation"}},
    {"name":"blog_draft_update","description":"Aendert einen eigenen Blogentwurf.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/updateMutation"}},
    {"name":"blog_draft_remove","description":"Entfernt einen eigenen Entwurf nach Konfliktpruefung.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/removeMutation"}},
    {"name":"blog_publish","description":"Veroeffentlicht einen Entwurf bewusst; private Speicherung allein veroeffentlicht nicht.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/publish"}},
    {"name":"blog_unpublish","description":"Nimmt eine eigene Veroeffentlichung zurueck und behaelt den privaten Entwurf.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/removeMutation"}},
    {"name":"blog_publications_list","description":"Listet freigegebene Blogpublikationen.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"blog_publication_get","description":"Liest eine freigegebene Blogpublikation.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/id"}},
    {"name":"settings_get","description":"Liest synchronisierte eigene Einstellungen.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/empty"}},
    {"name":"settings_update","description":"Aendert synchronisierte Einstellungen.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/updateWithoutId"}},
    {"name":"account_export","description":"Erzeugt eine kontogebundene Sicherungsprojektion ohne Secrets oder Betriebsdaten.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/empty"}},
    {"name":"package_preview","description":"Prueft ein kinodreieck-paket schreibfrei.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/packagePreview"}},
    {"name":"package_apply","description":"Uebernimmt bestaetigte Paketbereiche revisions- und idempotenzgebunden ohne KD-KI-Folgeaktion.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/packageApply"}},
    {"name":"schedule_list","description":"Listet eigene Kino-Pins und Wochenplaneintraege.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"schedule_add","description":"Fuegt einen Zeitplan- oder Kino-Pin-Eintrag hinzu.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/createMutation"}},
    {"name":"schedule_update","description":"Aendert einen Zeitplan- oder Kino-Pin-Eintrag.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/updateMutation"}},
    {"name":"schedule_remove","description":"Entfernt einen Zeitplan- oder Kino-Pin-Eintrag.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/removeMutation"}},
    {"name":"radar_list","description":"Listet den kontogebundenen Radarstand.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"radar_add","description":"Fuegt ein Radarziel hinzu; Member starten dabei keine KD-KI.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/createMutation"}},
    {"name":"radar_update","description":"Aendert ein Radarziel ohne implizite KI-Ausweitung.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/updateMutation"}},
    {"name":"radar_remove","description":"Entfernt ein Radarziel.","identities":["personal_owner_assistant","member_assistant"],"inputSchema":{"$ref":"#/$defs/removeMutation"}},
    {"name":"ai_job_start","description":"Startet einen erlaubten KD-KI-Auftrag unter bestehenden Budgets und Limits.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/aiJob"}},
    {"name":"ai_job_get","description":"Liest Status oder Ergebnis eines eigenen KI-Auftrags ohne neuen Providerrequest.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/id"}},
    {"name":"usage_get","description":"Liest eigene Assistentennutzung mit Zeitraum und Datenabdeckung.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/window"}},
    {"name":"requests_list","description":"Listet inhaltsfreie eigene Requestmetadaten.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"backend_status_get","description":"Liest begrenzten Backendstatus ohne Secrets oder private Inhalte.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/empty"}},
    {"name":"backend_diagnostics_get","description":"Liest begrenzte strukturierte Diagnosebefunde.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/page"}},
    {"name":"backend_usage_get","description":"Liest globale Betriebszahlen mit Zeitraum, Erfassungsbeginn und Abdeckung.","identities":["personal_owner_assistant"],"inputSchema":{"$ref":"#/$defs/window"}}
  ],
  "$defs": {
    "empty":{"type":"object","additionalProperties":false},
    "id":{"type":"object","required":["id"],"properties":{"id":{"type":"string","minLength":1,"maxLength":200}},"additionalProperties":false},
    "page":{"type":"object","properties":{"cursor":{"type":["string","null"],"maxLength":1000},"limit":{"type":"integer","minimum":1,"maximum":100,"default":20}},"additionalProperties":false},
    "search":{"type":"object","properties":{"query":{"type":"string","maxLength":200},"type":{"type":"string"},"cursor":{"type":["string","null"]},"limit":{"type":"integer","minimum":1,"maximum":100}},"additionalProperties":false},
    "operation":{"type":"object","required":["operationId","expectedRevision"],"properties":{"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0}}},
    "createMutation":{"type":"object","required":["operationId","expectedRevision","value"],"properties":{"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0},"value":{"type":"object"}},"additionalProperties":false},
    "updateMutation":{"type":"object","required":["id","operationId","expectedRevision","patch"],"properties":{"id":{"type":"string","minLength":1},"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0},"patch":{"type":"object","minProperties":1}},"additionalProperties":false},
    "updateWithoutId":{"type":"object","required":["operationId","expectedRevision","patch"],"properties":{"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0},"patch":{"type":"object","minProperties":1}},"additionalProperties":false},
    "removeMutation":{"type":"object","required":["id","operationId","expectedRevision"],"properties":{"id":{"type":"string","minLength":1},"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0}},"additionalProperties":false},
    "selection":{"type":"object","required":["ids","format"],"properties":{"ids":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1}},"format":{"enum":["text","json"]}},"additionalProperties":false},
    "publish":{"type":"object","required":["id","operationId","expectedRevision","anonymous"],"properties":{"id":{"type":"string"},"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0},"expectedPublicRevision":{"type":["integer","null"],"minimum":0},"anonymous":{"type":"boolean"}},"additionalProperties":false},
    "packagePreview":{"type":"object","required":["package"],"properties":{"package":{"type":"object"}},"additionalProperties":false},
    "packageApply":{"type":"object","required":["previewId","sections","operationId","expectedRevision"],"properties":{"previewId":{"type":"string"},"sections":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"operationId":{"type":"string","format":"uuid"},"expectedRevision":{"type":"integer","minimum":0}},"additionalProperties":false},
    "aiJob":{"type":"object","required":["operationId","kind","payload"],"properties":{"operationId":{"type":"string","format":"uuid"},"kind":{"type":"string","minLength":1,"maxLength":100},"payload":{"type":"object"}},"additionalProperties":false},
    "window":{"type":"object","required":["from","to"],"properties":{"from":{"type":"string","format":"date-time"},"to":{"type":"string","format":"date-time"}},"additionalProperties":false}
  }
}
