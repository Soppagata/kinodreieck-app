{
  "contractVersion": "kd-api-v1",
  "identities": {
    "app_session": "Normale App-Sitzung mit bestehenden Produktrechten",
    "personal_owner_assistant": "Registrierter persönlicher Owner-Assistent; exklusive KI/Diagnose nur mit expliziten Rechten",
    "member_assistant": "Registrierter kontogebundener Member-Assistent ohne KD-KI und ohne Nutzungs-/Betriebszahlen"
  },
  "operations": [
    {"userAction":"Mediathek suchen und filtern","domainOperation":"library.search","method":"GET","route":"/v1/library","tool":"library_search","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Mediathekeintrag lesen","domainOperation":"library.get","method":"GET","route":"/v1/library/{id}","tool":"library_get","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Film, Serie, Musik oder Sonstiges hinzufügen","domainOperation":"library.add","method":"POST","route":"/v1/library","tool":"library_add","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Bewertung, Status, Notiz, Besitz oder Serienfortschritt ändern","domainOperation":"library.update","method":"PATCH","route":"/v1/library/{id}","tool":"library_update","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Eigenen Mediathekeintrag entfernen","domainOperation":"library.remove","method":"DELETE","route":"/v1/library/{id}","tool":"library_remove","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Mehrfachauswahl als Titeltext oder JSON erzeugen","domainOperation":"library.selection.export","method":"POST","route":"/v1/library/selection/export","tool":"library_export_selection","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Text in Zwischenablage kopieren oder JSON-Datei speichern","domainOperation":"client.export.apply","method":null,"route":"app_local","tool":null,"identities":["app_session"],"note":"Clientwirkung; API und Tool liefern nur Inhalt, Dateiname und MIME-Typ."},
    {"userAction":"Must-Watch lesen und bearbeiten","domainOperation":"mustwatch.list|create|update|remove","method":"GET|POST|PATCH|DELETE","route":"/v1/must-watch|/v1/must-watch/{id}","tool":"mustwatch_list|mustwatch_add|mustwatch_update|mustwatch_remove","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Blogentwürfe auflisten und lesen","domainOperation":"blog.drafts.list|get","method":"GET","route":"/v1/blog-drafts|/v1/blog-drafts/{id}","tool":"blog_drafts_list|blog_draft_get","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Blogentwurf anlegen, ändern oder entfernen","domainOperation":"blog.drafts.create|update|remove","method":"POST|PATCH|DELETE","route":"/v1/blog-drafts|/v1/blog-drafts/{id}","tool":"blog_draft_create|blog_draft_update|blog_draft_remove","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Blog bewusst veröffentlichen oder zurücknehmen","domainOperation":"blog.publish|unpublish","method":"POST","route":"/v1/blog-drafts/{id}/publish|/v1/blog-publications/{id}/unpublish","tool":"blog_publish|blog_unpublish","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Freigegebene Blogs lesen","domainOperation":"blog.publications.list|get","method":"GET","route":"/v1/blog-publications|/v1/blog-publications/{id}","tool":"blog_publications_list|blog_publication_get","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Einstellungen lesen und ändern","domainOperation":"settings.get|update","method":"GET|PATCH","route":"/v1/settings","tool":"settings_get|settings_update","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Persönliche Datensicherung exportieren","domainOperation":"account.export","method":"POST","route":"/v1/account/export","tool":"account_export","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Paket nach Vorschau importieren","domainOperation":"package.preview|apply","method":"POST","route":"/v1/packages/preview|/v1/packages/apply","tool":"package_preview|package_apply","identities":["app_session","personal_owner_assistant","member_assistant"],"note":"Anwenden braucht Revision und Idempotency-Key; keine indirekte KI."},
    {"userAction":"Kino-Pins und Wochenplan lesen/bearbeiten","domainOperation":"schedule.list|mutate","method":"GET|POST|PATCH|DELETE","route":"/v1/schedule|/v1/schedule/{id}","tool":"schedule_list|schedule_add|schedule_update|schedule_remove","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"Radar-Abos, Pins und Belege lesen/bearbeiten","domainOperation":"radar.list|mutate","method":"GET|POST|PATCH|DELETE","route":"/v1/radar|/v1/radar/{id}","tool":"radar_list|radar_add|radar_update|radar_remove","identities":["app_session","personal_owner_assistant","member_assistant"],"note":"Memberaktionen tragen aiAuthorized=false und starten keine KD-KI-Folgeaktion."},
    {"userAction":"Eigene Fähigkeiten anzeigen","domainOperation":"capabilities.get","method":"GET","route":"/v1/capabilities","tool":"capabilities_get","identities":["app_session","personal_owner_assistant","member_assistant"]},
    {"userAction":"KD-KI-Auftrag starten und Status lesen","domainOperation":"ai.jobs.start|get","method":"POST|GET","route":"/v1/ai/jobs|/v1/ai/jobs/{id}","tool":"ai_job_start|ai_job_get","identities":["personal_owner_assistant"]},
    {"userAction":"Assistenten-Nutzung und Requestmetadaten lesen","domainOperation":"assistant.usage|getRequests","method":"GET","route":"/v1/assistant/usage|/v1/assistant/requests","tool":"usage_get|requests_list","identities":["personal_owner_assistant"]},
    {"userAction":"Backendstatus, Diagnose und globale Nutzung lesen","domainOperation":"assistant.backend.status|diagnostics|usage","method":"GET","route":"/v1/assistant/backend/status|/v1/assistant/backend/diagnostics|/v1/assistant/backend/usage","tool":"backend_status_get|backend_diagnostics_get|backend_usage_get","identities":["personal_owner_assistant"]},
    {"userAction":"Kontolöschung anfragen oder Auth-/Gerätesitzung verwalten","domainOperation":"account.sensitive","method":null,"route":"app_local","tool":null,"identities":["app_session"],"note":"Bleibt im bestehenden interaktiven Auth-/Bestätigungsweg; kein API-Key-Werkzeug in v1."},
    {"userAction":"Lokale Darstellung, Suche, Sortierung, Filter und Modus ändern","domainOperation":"client.preferences","method":null,"route":"app_local","tool":null,"identities":["app_session"],"note":"Gerätewirkung; synchronisierte Settings laufen über /v1/settings."}
  ]
}
